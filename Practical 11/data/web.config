<?php
/**
 * .htaccess equivalent for Windows/IIS - Web.config
 * Protects the data directory from direct web access
 */
?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="data" />
                </hiddenSegments>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>